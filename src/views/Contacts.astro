---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { useT, href, CONTACTS, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const channels = [
  { icon: 'whatsapp', label: 'WhatsApp', value: CONTACTS.phone, url: CONTACTS.phoneHref },
  { icon: 'telegram', label: 'Telegram', value: CONTACTS.telegram, url: CONTACTS.telegramHref },
  { icon: 'instagram', label: 'Instagram', value: CONTACTS.instagram, url: CONTACTS.instagramHref },
  { icon: 'mail', label: 'Email', value: CONTACTS.email, url: `mailto:${CONTACTS.email}` },
] as const;
---

<Base lang={lang} path="/contacts/" title={t('contacts.title')}>
  <div class="container page">
    <nav class="crumbs" aria-label="breadcrumbs">
      <a href={href(lang, '/')}>{t('nav.home')}</a>
      <span aria-hidden="true">/</span>
      <span>{t('contacts.title')}</span>
    </nav>
    <h1>{t('contacts.title')}</h1>

    <div class="grid">
      <div class="cards">
        <section class="card">
          <h2><Icon name="pin" />{t('contacts.address')}</h2>
          <p>{t('footer.address')}</p>
          <a class="link-arrow" href={CONTACTS.mapHref} target="_blank" rel="noopener">{t('footer.map')}</a>
        </section>
        <section class="card">
          <h2><Icon name="clock" />{t('contacts.hours')}</h2>
          <p class="pre">{t('contacts.hoursValue')}</p>
        </section>
        <section class="card card-pink">
          <h2><Icon name="chat" />{t('contacts.write')}</h2>
          <p>{t('contacts.writeText')}</p>
          <ul class="channels">
            {
              channels.map((c) => (
                <li>
                  <a href={c.url} target={c.icon === 'mail' ? undefined : '_blank'} rel="noopener">
                    <Icon name={c.icon} size={22} />
                    <span>
                      <small>{c.label}</small>
                      {c.value}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
      <div class="map">
        <iframe
          src={CONTACTS.mapEmbed}
          title={t('contacts.address')}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: 24px 80px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .crumbs a {
    text-decoration: none;
  }
  h1 {
    color: var(--green);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 24px;
  }
  .cards {
    display: grid;
    gap: 16px;
  }
  .card {
    padding: 24px;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .card-pink {
    background: var(--pink);
  }
  .card h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    color: var(--green);
  }
  .card p {
    margin-bottom: 8px;
  }
  .pre {
    white-space: pre-line;
  }
  .channels {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .channels a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--white);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .channels a:hover {
    box-shadow: 0 0 0 2px var(--green);
  }
  .channels :global(svg) {
    flex: none;
    color: var(--green);
  }
  .channels small {
    display: block;
    color: var(--muted);
    font-size: 12px;
  }
  .map {
    min-height: 420px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--cream);
  }
  .map iframe {
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
    display: block;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .channels {
      grid-template-columns: 1fr;
    }
  }
</style>
