---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { useT, href, CONTACTS, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: 'info' | 'returns' | 'privacy';
  title: string;
}

const texts = import.meta.glob<{ Content: any }>('../texts/*/*.md', { eager: true });
const { lang, page, title } = Astro.props;
const t = useT(lang);
const { Content } = texts[`../texts/${lang}/${page}.md`];
const path = `/${page}/`;
---

<Base lang={lang} path={path} title={title}>
  <div class="container page">
    <nav class="crumbs" aria-label="breadcrumbs">
      <a href={href(lang, '/')}>{t('nav.home')}</a>
      <span aria-hidden="true">/</span>
      <span>{title}</span>
    </nav>
    <div class="layout">
      <article class="prose content">
        <h1>{title}</h1>
        <Content />
      </article>
      <aside class="help">
        <p class="help-title">{t('contacts.write')}</p>
        <p>{t('contacts.writeText')}</p>
        <a class="btn btn-block" href={CONTACTS.phoneHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />WhatsApp</a>
        <a class="btn btn-outline btn-block" href={CONTACTS.telegramHref} target="_blank" rel="noopener"><Icon name="telegram" size={20} />Telegram</a>
      </aside>
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: 24px 80px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .crumbs a {
    text-decoration: none;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }
  .content {
    padding: clamp(24px, 4vw, 48px);
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    max-width: 820px;
  }
  .content h1 {
    color: var(--green);
  }
  .content :global(h2) {
    color: var(--green);
  }
  .content :global(h2:first-of-type) {
    margin-top: 0.8em;
  }
  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
    font-size: 15px;
  }
  .content :global(th),
  .content :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .content :global(th) {
    background: var(--cream);
  }
  .help {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 12px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--pink);
  }
  .help p {
    margin: 0;
  }
  .help-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    color: var(--green);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .help {
      position: static;
    }
    .content :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
