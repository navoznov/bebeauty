---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import mascot from '../assets/brand/mascot.png';
import { useT, href, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'ru' ? 'en' : 'ru';

const nav = [
  { label: t('nav.catalog'), to: '/catalog/' },
  { label: t('nav.new'), to: '/catalog/new/' },
  { label: t('nav.sale'), to: '/catalog/sale/' },
  { label: t('nav.georgia'), to: '/catalog/made-in-georgia/' },
  { label: t('nav.info'), to: '/info/' },
  { label: t('nav.contacts'), to: '/contacts/' },
];
const isActive = (to: string) => (to === '/catalog/' ? path === to : path.startsWith(to));
---

<div class="topbar">
  <div class="container topbar-inner">
    <p class="topbar-ship"><Icon name="truck" size={18} />{t('topbar.shipping')}</p>
    <p class="topbar-store"><Icon name="pin" size={18} />{t('topbar.store')}</p>
    <a class="lang" href={href(other, path)} hreflang={other} lang={other}>
      <Icon name="globe" size={18} />{t('lang.switch')}
    </a>
  </div>
</div>

<header class="header">
  <div class="container header-inner">
    <a class="logo" href={href(lang, '/')} aria-label="BeBeauty">
      <Image src={mascot} alt="" width={88} height={88} class="logo-img" loading="eager" />
      <span class="logo-text">BeBeauty</span>
    </a>

    <nav class="nav" aria-label={t('nav.catalog')}>
      {
        nav.map((n) => (
          <a href={href(lang, n.to)} aria-current={isActive(n.to) ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a class="icon-btn" href={href(lang, '/catalog/#search')} aria-label={t('nav.search')}>
        <Icon name="search" />
      </a>
      <a class="icon-btn cart-btn" href={href(lang, '/cart/')} aria-label={t('nav.cart')}>
        <Icon name="cart" />
        <span class="badge" data-cart-count hidden>0</span>
      </a>
      <button class="icon-btn menu-btn" type="button" aria-label={t('nav.menu')} data-menu-open>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<dialog class="drawer" aria-label={t('nav.menu')}>
  <div class="drawer-head">
    <span class="logo-text">BeBeauty</span>
    <button class="icon-btn" type="button" aria-label={t('nav.close')} data-menu-close>
      <Icon name="close" />
    </button>
  </div>
  <nav class="drawer-nav">
    <a href={href(lang, '/')}>{t('nav.home')}</a>
    {nav.map((n) => <a href={href(lang, n.to)}>{n.label}</a>)}
    <a href={href(lang, '/returns/')}>{t('nav.returns')}</a>
  </nav>
  <div class="drawer-foot">
    <a class="btn btn-pink btn-block" href={href(other, path)} hreflang={other} lang={other}>
      <Icon name="globe" size={20} />{t('lang.switch')}
    </a>
    <p>{t('topbar.shipping')}</p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.drawer')!;
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => dialog.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .topbar {
    background: var(--green-900);
    color: var(--cream);
    font-size: 13px;
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 38px;
  }
  .topbar p {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .topbar-store {
    opacity: 0.8;
  }
  .lang {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    padding: 4px 0;
  }
  .lang:hover {
    text-decoration: underline;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--green);
    color: var(--white);
    box-shadow: 0 1px 0 rgb(255 255 255 / 8%);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 72px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex: none;
  }
  .logo-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .logo-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav {
    display: flex;
    gap: 4px;
    margin-inline: auto;
  }
  .nav a {
    padding: 8px 12px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 15px;
    white-space: nowrap;
    transition: background-color 0.15s;
  }
  .nav a:hover {
    background: rgb(255 255 255 / 10%);
  }
  .nav a[aria-current='page'] {
    background: var(--pink);
    color: var(--green-900);
  }
  .actions {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .nav + .actions {
    margin-left: 0;
  }
  .icon-btn {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .icon-btn:hover {
    background: rgb(255 255 255 / 12%);
  }
  .cart-btn {
    background: var(--pink);
    color: var(--green-900);
  }
  .cart-btn:hover {
    background: #eeb8dc;
  }
  .badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--berry);
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
  }
  .menu-btn {
    display: none;
  }

  .drawer {
    margin: 0 0 0 auto;
    width: min(360px, 88vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 20px 24px;
    border: 0;
    background: var(--green);
    color: var(--white);
  }
  .drawer::backdrop {
    background: rgb(0 0 0 / 40%);
  }
  .drawer[open] {
    display: flex;
    flex-direction: column;
  }
  .drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .drawer-nav {
    display: grid;
  }
  .drawer-nav a {
    padding: 14px 0;
    border-bottom: 1px solid rgb(255 255 255 / 14%);
    text-decoration: none;
    font-size: 18px;
  }
  .drawer-foot {
    margin-top: auto;
    display: grid;
    gap: 12px;
    font-size: 14px;
    opacity: 0.95;
  }
  .drawer-foot p {
    margin: 0;
    text-align: center;
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: inline-grid;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (max-width: 720px) {
    .topbar .topbar-store,
    .topbar .lang {
      display: none;
    }
    .topbar-inner {
      justify-content: center;
    }
    .header-inner {
      min-height: 60px;
      gap: 12px;
    }
    .logo-img {
      width: 38px;
      height: 38px;
    }
    .logo-text {
      font-size: 19px;
    }
  }
</style>
