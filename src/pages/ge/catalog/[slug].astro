---
import Catalog from '../../../views/Catalog.astro';
import { getCategories, COLLECTIONS } from '../../../lib/catalog';

export function getStaticPaths() {
  return [...COLLECTIONS, ...getCategories('ka').map((c) => c.slug)].map((slug) => ({ params: { slug } }));
}
---

<Catalog lang="ka" slug={Astro.params.slug} />
