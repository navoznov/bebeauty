---
import Catalog from '../../views/Catalog.astro';
import { getCategories, COLLECTIONS } from '../../lib/catalog';

export function getStaticPaths() {
  return [...COLLECTIONS, ...getCategories('ru').map((c) => c.slug)].map((slug) => ({ params: { slug } }));
}
---

<Catalog lang="ru" slug={Astro.params.slug} />
